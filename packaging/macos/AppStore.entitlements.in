<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Droits de la version Mac App Store (scripts/bundle-macos.sh, APPSTORE=1).
  Mouflon n'a besoin de rien d'autre que du bac à sable : pas de réseau, pas
  de fichiers hors de son conteneur. Les animaux glissés depuis le Finder
  restent lisibles (le glisser-déposer accorde l'accès au fichier déposé).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>@TEAM_ID@.@BUNDLE_ID@</string>
    <key>com.apple.developer.team-identifier</key>
    <string>@TEAM_ID@</string>
</dict>
</plist>
